# Copier vers .env. Ne jamais committer .env.
# Valeurs de démonstration uniquement. Les utilisateurs et tickets sont fictifs.

APP_SECRET=change-me-demo-secret
STORAGE_BACKEND=local
DATABASE_URL=sqlite:///./data/maintidoc.db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=maintidoc
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=maintidoc
MINIO_SECRET_KEY=maintidoc-demo-secret
MINIO_BUCKET=maintidoc
MINIO_SECURE=0
MCP_URL=http://localhost:8001/mcp
MLFLOW_TRACKING_URI=
USE_HEAVY_MODELS=0
USE_VLM=0
EMBEDDING_MODEL=hashing-multilingual-v1
VISION_ENCODER=colorhist-v1
VLM_MODEL=Qwen/Qwen2.5-VL-7B-Instruct
INDEX_VERSION=idx-synth-v1
RERANKER_MODE=original
RERANKER_WEIGHTS=artifacts/reranker_adapted.json
USER_DAILY_QUOTA=30
MAX_MCP_CALLS=3
MAX_MODEL_CALLS=6
MAX_PROCESSING_SECONDS=60
MAX_IMAGE_BYTES=5000000
MAX_CONTEXT_CHARS=6000
MAX_OUTPUT_TOKENS=800
API_URL=http://localhost:8000
